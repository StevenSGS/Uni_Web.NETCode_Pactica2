@model List<Producto>
@{
    ViewData["Title"] = "Inventario de Bodegas";
}

<h2>Inventario de Bodegas</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Cantidad</th>
            <th>Precio Unitario</th>
            <th>Estado</th>
            <th>Bodega</th>
        </tr>
    </thead>
    <tbody>
    @for (int i = 0; i < Model.Count; i++)
    {
        var producto = Model[i];

        <tr>
            <td>@(i + 1)</td>
            <td>@producto.Nombre</td>
            <td>@producto.Tipo</td>
            <td>@producto.Cantidad</td>
            <td>@producto.PrecioUnitario</td>
            <td>
                <span class="badge @(producto.Cantidad < 20 ? "text-bg-danger" : "text-bg-success")">
                    @EvaluarCantidad(producto.Cantidad)
                </span>
            </td>
            <td>
                @switch (producto.Tipo)
                {
                    case "Natural":
                        <span class="badge text-bg-secondary">Bodega 1</span>
                        break;
                    case "Químico":
                        <span class="badge text-bg-secondary">Bodega 2</span>
                        break;
                    case "Líquido":
                        <span class="badge text-bg-secondary">Bodega 3</span>
                        break;
                    default:
                        <span class="badge text-bg-warning">Por asignar</span>
                        break;
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@functions {
    public string EvaluarCantidad(int cantidad)
    {
        if (cantidad < 20)
        {
            return "Stock limitado - solicitar nuevo";
        }

        return "Stock suficiente";
    }
}
