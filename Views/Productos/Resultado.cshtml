@model Producto
@{
    ViewData["Title"] = "Producto Registrado";
}

<div class="alert alert-success" role="alert">
    La información recibida es válida.
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Producto Registrado Correctamente</h5>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><strong>Nombre:</strong> @Model.Nombre</li>
                <li class="list-group-item"><strong>Tipo:</strong> @Model.Tipo</li>
                <li class="list-group-item"><strong>Cantidad:</strong> @Model.Cantidad</li>
                <li class="list-group-item"><strong>Precio Unitario:</strong> @Model.PrecioUnitario</li>
                <li class="list-group-item"><strong>Bodega:</strong> @(Model.Tipo == "Natural" ? "Bodega 1" : Model.Tipo == "Químico" ? "Bodega 2" : Model.Tipo == "Líquido" ? "Bodega 3" : "Por asignar")</li>
            </ul>
        </div>
        <a asp-action="CrearProducto" class="btn btn-primary mt-3">Registrar otro producto</a>
    </div>
</div>
